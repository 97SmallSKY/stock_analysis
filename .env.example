# ============================================================
# 龙虎榜量化交易系统 — 环境变量模板
# 复制为 .env 并填写实际值。.env 已被 .gitignore 排除。
# ============================================================

# ---- TuShare (当前 120 积分仅用于日 K) ----
TUSHARE_TOKEN=
TUSHARE_POINTS=120

# ---- 数据库 ----
# 生产 (jd 本机)     : PG_HOST=localhost
# 开发 (本地连 jd)   : PG_HOST=117.72.184.8
PG_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lhb_quant
POSTGRES_USER=lhb_admin
POSTGRES_PASSWORD=change_me_in_prod
PG_TABLE_PREFIX=

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_BROKER=1

# ---- 后端 ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_me_to_a_random_string
LOG_LEVEL=INFO

# ---- 存储模式 ----
STORAGE_MODE=postgres

# ---- pgAdmin (仅本地 docker-compose 使用) ----
PGADMIN_EMAIL=admin@lhb-quant.com
PGADMIN_PASSWORD=admin123456
PGADMIN_PORT=5050

# ---- 通知 (可选，为空则跳过) ----
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK_URL=
SERVER_CHAN_KEY=

# ---- 交易 / 调度 ----
SKIP_CIRCUIT_BREAKER=false
MONITOR_INTERVAL_SEC=10         # 盘中行情轮询间隔
SNAP_INTERVAL_MIN=5             # 行情快照存储间隔(分钟)
ELIMINATION_ENABLED=true
ELIMINATION_DAY=5               # 1=周一, 5=周五

# ---- LLM 选股 (可选) ----
LLM_ENABLED=true
LLM_FALLBACK_RULE=true

# ---- 爬虫 (自研) ----
WANQING_COOKIES_PATH=./cookies.json
