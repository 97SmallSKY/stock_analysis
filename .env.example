# ============================================================
# 龙虎榜量化交易系统 v2 - 环境变量模板
# 复制此文件为 .env 并填写实际值
# ============================================================

# ============================================================
# 数据库配置
# ============================================================
POSTGRES_DB=stock_quant
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=your_secure_password_here

# ============================================================
# Redis 配置
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# 后端配置
# ============================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-string

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================
# 数据源配置
# ============================================================

# TuShare Pro Token (必填，用于获取日K线等数据)
# 申请地址: https://tushare.pro/
TUSHARE_TOKEN=

# 万卿代理 Cookie 路径
WANQING_COOKIES_PATH=/app/cookies.json

# ============================================================
# 通知配置
# ============================================================

# 飞书 Webhook URL (可选)
# 格式: https://open.feishu.cn/open-apis/bot/v2/hook/xxx
FEISHU_WEBHOOK_URL=

# ============================================================
# 交易配置
# ============================================================

# 是否跳过熔断检查 (仅调试用)
SKIP_CIRCUIT_BREAKER=false

# 盘中行情轮询间隔 (秒)
MONITOR_INTERVAL_SEC=10

# 行情快照存储间隔 (分钟)
SNAP_INTERVAL_MIN=5

# 是否启用自动淘汰
ELIMINATION_ENABLED=true

# 每周几执行淘汰 (5=周五)
ELIMINATION_DAY=5

# LLM 选股开关
LLM_ENABLED=true

# LLM 失败时启用规则降级
LLM_FALLBACK_RULE=true
