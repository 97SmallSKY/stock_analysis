[Unit]
Description=stock_analysis daily pm data update (LHB + seats + sentiment + kline + score)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/stock_analysis
# 建议在 /etc/default/stock_analysis 里配置 DB_* / TUSHARE_TOKEN 等环境
EnvironmentFile=-/etc/default/stock_analysis
ExecStart=/bin/bash /root/stock_analysis/scripts/daily_update.sh
StandardOutput=append:/root/stock_analysis/logs/daily_update.systemd.log
StandardError=append:/root/stock_analysis/logs/daily_update.systemd.log
# 失败了 exit>0 由 systemctl 记状态,配套 OnFailure 可选
TimeoutStartSec=3h

[Install]
WantedBy=multi-user.target
