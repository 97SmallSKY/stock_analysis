[Unit]
Description=Stock Analysis Celery Worker
After=network.target redis-server.service postgresql.service
Wants=redis-server.service postgresql.service

[Service]
Type=simple
User=xiaotian
WorkingDirectory=/home/xiaotian/stock_analysis
EnvironmentFile=/home/xiaotian/stock_analysis/.env
Environment="HTTP_PROXY="
Environment="HTTPS_PROXY="
Environment="NO_PROXY=*"
ExecStart=/home/xiaotian/stock_analysis/.venv/bin/celery \
    -A backend.tasks.app worker \
    --loglevel=info --concurrency=4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
