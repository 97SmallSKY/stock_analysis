[Unit]
Description=Stock Analysis APScheduler
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=xiaotian
WorkingDirectory=/home/xiaotian/stock_analysis
EnvironmentFile=/home/xiaotian/stock_analysis/.env
Environment="HTTP_PROXY="
Environment="HTTPS_PROXY="
Environment="NO_PROXY=*"
ExecStart=/home/xiaotian/stock_analysis/.venv/bin/python -m backend.scheduler.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
